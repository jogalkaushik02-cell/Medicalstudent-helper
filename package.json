{
  "name": "senses-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "audit": "node scripts/audit-data.mjs",
    "smoke": "node scripts/smoke.mjs",
    "review": "npm run typecheck && npm run audit && npm run smoke"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.17.10",
    "clsx": "2.1.1",
    "lucide-react": "0.451.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.7",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.2",
    "esbuild": "0.21.5",
    "typescript": "5.6.2",
    "vite": "5.4.8"
  }
}
